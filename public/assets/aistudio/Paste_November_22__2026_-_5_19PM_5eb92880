   NAVEGACIÓN Y SINCRONIZACIÓN GLOBAL
   ========================================================================== */
const TITULOS_VISTAS = {
  buscar: "Explorar catálogo",
  publicar: "Publicar herramienta",
  solicitudes: "Préstamos y solicitudes",
  incidencias: "Incidencias y comunidad",
  configuracion: "Configuración y aspecto"
};

function navegarA(vista) {
  document.querySelectorAll(".view").forEach(v => v.classList.remove("active"));
  document.querySelectorAll(".nav-item").forEach(b => b.classList.remove("active"));

  document.getElementById(`view-${vista}`).classList.add("active");
  const navBtn = document.querySelector(`.nav-item[data-view="${vista}"]`);
  if (navBtn) navBtn.classList.add("active");

  document.getElementById("topbar-title").textContent = TITULOS_VISTAS[vista] || vista;
  document.getElementById("sidebar").classList.remove("open");

  if (vista === "solicitudes") uiGestionar.renderizar();
  if (vista === "incidencias") renderizarComunidad();
  if (vista === "configuracion") uiConfig.rellenarFormularioPerfil();
}

function sincronizarUsuarioUI() {
  const select = document.getElementById("quick-user-select");
  select.innerHTML = RepositorioSistema.vecinos
    .map(v => `<option value="${v.idVecino}">${v.nombre} (${v.direccion})</option>`)
    .join("");
  select.value = ctrlRegistro.vecinoActual.idVecino;

  const v = ctrlRegistro.vecinoActual;
  document.getElementById("sidebar-user-card").innerHTML = `
    <div class="avatar">${v.obtenerIniciales()}</div>
    <div class="user-meta">
      <strong>${v.nombre}</strong>
      <span>${v.direccion}</span>
    </div>
  `;
  uiConfig.rellenarFormularioPerfil();
  uiPublicar.actualizarPreview();
}

function renderizarComunidad() {
  const badgeInc = document.getElementById("badge-incidencias");
  badgeInc.style.display = RepositorioSistema.incidencias.length ? "inline-block" : "none";
  badgeInc.textContent = RepositorioSistema.incidencias.length;

  const contInc = document.getElementById("lista-incidencias");
  contInc.innerHTML = RepositorioSistema.incidencias.length
    ? RepositorioSistema.incidencias
        .map(inc => {
          const rep = RepositorioSistema.vecinos.find(v => v.idVecino === inc.idReportante);
          return `
            <div style="padding:0.9rem; border-radius:10px; background:var(--bg-subtle); border-left:3px solid var(--danger);">
              <div style="display:flex; justify-content:space-between; margin-bottom:0.3rem;">
                <strong>Gravedad: ${inc.gravedad}</strong>
                <span class="badge-mono">${inc.fecha}</span>
              </div>
              <p style="font-size:0.86rem;">${inc.descripcion}</p>
              <small style="color:var(--text-muted);">Reportado por ${rep?.nombre || "Vecino"}</small>
            </div>
          `;
        })
        .join("")
    : `<p style="font-size:0.86rem; color:var(--text-muted);">No hay incidencias abiertas en la comunidad. ¡Buen trabajo!</p>`;

  document.getElementById("lista-vecinos-comunidad").innerHTML = RepositorioSistema.vecinos
    .map(v => {
      const numHerr = RepositorioSistema.herramientas.filter(h => h.idPropietario === v.idVecino).length;
      return `
        <div class="user-card" style="justify-content:space-between;">
          <div style="display:flex; align-items:center; gap:0.65rem;">
            <div class="avatar">${v.obtenerIniciales()}</div>
            <div class="user-meta">
              <strong>${v.nombre}</strong>
              <span>${v.direccion}</span>
            </div>
          </div>
          <span class="badge-mono">${numHerr} herr.</span>
        </div>
      `;
    })
    .join("");
}

